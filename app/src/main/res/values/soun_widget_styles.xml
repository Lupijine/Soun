<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="SounWidgetTitle">
        <item name="android:textColor">@color/soun_widget_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SounWidgetSubtitle">
        <item name="android:textColor">@color/soun_widget_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SounWidgetTime">
        <item name="android:textColor">@color/soun_widget_text_tertiary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SounWidgetTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="SounWidgetTileArtworkFrame">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
    </style>

    <style name="SounWidgetTileArtwork">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/soun_widget_tile_placeholder</item>
        <item name="android:contentDescription">@string/widget_playlists</item>
    </style>

    <style name="SounWidgetTilePlayButton">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/soun_widget_glass_orb</item>
    </style>

    <style name="SounWidgetTilePlayIcon">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:src">@drawable/soun_widget_ic_play</item>
        <item name="android:contentDescription">@string/play</item>
    </style>

    <style name="SounWidgetTileTitle" parent="SounWidgetTitle">
        <item name="android:layout_width">68dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
