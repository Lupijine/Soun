<?xml version="1.0" encoding="utf-8"?>
<!-- Turntable 2x2: glass square holding the disc, skip controls top-right and a glass play button bottom-right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soun_widget_glass_panel"
    android:theme="@style/Theme.Widget.Metrolist">

    <!-- Album art - circular bitmap set programmatically -->
    <ImageView
        android:id="@+id/widget_turntable_album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_turntable_default_art"
        android:contentDescription="@string/album_art" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:background="@drawable/soun_widget_glass_pill"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widget_turntable_prev_button"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:src="@drawable/soun_widget_ic_previous"
            android:contentDescription="@string/previous" />

        <ImageButton
            android:id="@+id/widget_turntable_next_button"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:src="@drawable/soun_widget_ic_next"
            android:contentDescription="@string/next" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_turntable_play_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/soun_widget_glass_orb">

        <ImageView
            android:id="@+id/widget_turntable_play_pause"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/soun_widget_ic_play"
            android:contentDescription="@string/play_pause" />
    </FrameLayout>
</FrameLayout>
