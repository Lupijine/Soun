<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 Now Playing: glass pill with a round cover, song info, glass play button and next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/soun_widget_glass_pill"
    android:clipToOutline="true"
    android:paddingStart="6dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical"
    android:theme="@style/Theme.Widget.Metrolist"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_wide_album_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:maxWidth="56dp"
        android:maxHeight="56dp"
        android:scaleType="fitCenter"
        android:src="@drawable/soun_widget_cover_round_placeholder"
        android:contentDescription="@string/album_art" />

    <LinearLayout
        android:id="@+id/widget_wide_info_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_wide_song_title"
            style="@style/SounWidgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/soun_widget_nothing_playing"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_wide_artist_name"
            style="@style/SounWidgetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/tap_to_play"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_wide_play_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/soun_widget_glass_button">

        <ImageView
            android:id="@+id/widget_wide_play_pause"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/soun_widget_ic_play"
            android:contentDescription="@string/play_pause" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_wide_next_container"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/soun_widget_ic_next"
            android:contentDescription="@string/next" />
    </FrameLayout>
</LinearLayout>
