<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing widget with nothing in the player: lotus mark, prompt and Resume / Shuffle liked pills -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soun_widget_glass_panel"
    android:clipToOutline="true"
    android:theme="@style/Theme.Widget.Metrolist"
    tools:targetApi="31">

    <LinearLayout
        android:id="@+id/widget_empty_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/soun_widget_glass_button">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/small_icon"
                    android:tint="@color/soun_widget_icon"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SounWidgetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soun_widget_nothing_playing"
                    android:textSize="17sp" />

                <TextView
                    style="@style/SounWidgetSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/soun_widget_pick_up"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/widget_empty_resume"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/soun_widget_solid_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/soun_widget_ic_play"
                    android:tint="@color/soun_widget_solid_button_content"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/SounWidgetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/soun_widget_resume"
                    android:textColor="@color/soun_widget_solid_button_content"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_empty_shuffle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/soun_widget_glass_chip"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/shuffle"
                    android:tint="@color/soun_widget_icon"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/SounWidgetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/soun_widget_shuffle_liked"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
