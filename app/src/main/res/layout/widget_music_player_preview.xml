<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview of the 4x2 Now Playing widget (static sample content) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soun_widget_glass_panel"
    android:clipToOutline="true"
    android:theme="@style/Theme.Widget.Metrolist"
    tools:targetApi="31">

    <!-- Blurred album art + scrim, rim and highlight; shown on API 31+ when artwork is available -->
    <FrameLayout
        android:id="@+id/widget_album_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/soun_widget_album_glass_overlay">

        <ImageView
            android:id="@+id/widget_album_glass_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/soun_widget_preview_glow"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="46"
            android:scaleType="fitCenter"
            android:src="@drawable/soun_widget_cover_placeholder"
            android:contentDescription="@string/album_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="54"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_info_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_song_title"
                        style="@style/SounWidgetTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/soun_widget_preview_title"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/widget_artist_name"
                        style="@style/SounWidgetSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/soun_widget_preview_artist"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:alpha="0.85"
                    android:src="@drawable/small_icon"
                    android:tint="@color/soun_widget_icon"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/soun_widget_progress_track"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="40"
                        android:scaleType="fitXY"
                        android:src="@drawable/soun_widget_progress_fill"
                        android:importantForAccessibility="no"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="60" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_progress_elapsed"
                    style="@style/SounWidgetTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/soun_widget_preview_elapsed" />

                <TextView
                    android:id="@+id/widget_progress_duration"
                    style="@style/SounWidgetTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/soun_widget_preview_duration" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/widget_like_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/widget_like_button"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/soun_widget_ic_heart_filled"
                        android:contentDescription="@string/like" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_prev_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/soun_widget_ic_previous"
                        android:contentDescription="@string/previous" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_play_pause_container"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/soun_widget_glass_button">

                    <ImageView
                        android:id="@+id/widget_play_pause"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/soun_widget_ic_pause"
                        android:contentDescription="@string/play_pause" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_next_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/soun_widget_ic_next"
                        android:contentDescription="@string/next" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
