<?xml version="1.0" encoding="utf-8"?>
<!-- Soun artwork placeholder: plum-to-pink glass tile with the lotus mark -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:type="linear"
                android:startColor="#3B1B45"
                android:centerColor="#8E4A86"
                android:endColor="#E59AB4" />
            <corners android:radius="20dp" />
            <size
                android:width="148dp"
                android:height="148dp" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:gravity="center"
        android:drawable="@drawable/small_icon" />
</layer-list>
