<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over the blurred album art: darkening (or lightening) scrim, glass sheen, rim and highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:type="linear"
                android:startColor="@color/soun_widget_album_scrim_start"
                android:endColor="@color/soun_widget_album_scrim_end" />
            <corners android:radius="@dimen/soun_widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:type="linear"
                android:startColor="@color/soun_widget_album_sheen_start"
                android:endColor="@color/soun_widget_album_sheen_end" />
            <stroke
                android:width="1dp"
                android:color="@color/soun_widget_glass_rim" />
            <corners android:radius="@dimen/soun_widget_radius" />
        </shape>
    </item>
    <!-- Brighter 1dp specular highlight along the straight part of the top edge -->
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="@dimen/soun_widget_radius"
        android:right="@dimen/soun_widget_radius">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/soun_widget_glass_highlight_clear"
                android:centerColor="@color/soun_widget_glass_highlight"
                android:endColor="@color/soun_widget_glass_highlight_clear" />
        </shape>
    </item>
</layer-list>
