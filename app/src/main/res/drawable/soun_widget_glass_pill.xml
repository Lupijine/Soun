<?xml version="1.0" encoding="utf-8"?>
<!-- Faked Liquid Glass: tinted base, diagonal sheen, light rim and a top highlight.
     Colors switch with values-night; the radius follows the launcher on API 31+. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/soun_widget_glass_base" />
            <corners android:radius="@dimen/soun_widget_pill_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:type="linear"
                android:startColor="@color/soun_widget_glass_fill_start"
                android:endColor="@color/soun_widget_glass_fill_end" />
            <stroke
                android:width="1dp"
                android:color="@color/soun_widget_glass_rim" />
            <corners android:radius="@dimen/soun_widget_pill_radius" />
        </shape>
    </item>
    <!-- Brighter 1dp specular highlight along the straight part of the top edge -->
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="36dp"
        android:right="36dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/soun_widget_glass_highlight_clear"
                android:centerColor="@color/soun_widget_glass_highlight"
                android:endColor="@color/soun_widget_glass_highlight_clear" />
        </shape>
    </item>
</layer-list>
