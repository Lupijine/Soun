<?xml version="1.0" encoding="utf-8"?>
<!-- Glass circle with the tinted base, for buttons that sit on top of artwork -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/soun_widget_glass_base" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:type="linear"
                android:startColor="@color/soun_widget_glass_fill_start"
                android:endColor="@color/soun_widget_glass_fill_end" />
            <stroke
                android:width="1dp"
                android:color="@color/soun_widget_glass_rim" />
        </shape>
    </item>
</layer-list>
